APP_ENV=development
FRONTEND_DIST_DIR=/app/frontend_dist

DATABASE_URL=postgresql+asyncpg://pitwall:pitwall@localhost:5433/pitwall
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173

OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT_SECONDS=60
OPENF1_MIN_REQUEST_INTERVAL_SECONDS=0.40
OPENF1_MAX_RETRIES=4

# Canonical prepared files. Use "local" for development or "s3" for an
# S3-compatible service such as Cloudflare R2 in production.
STORAGE_BACKEND=local
STORAGE_CACHE_DIR=./data/object_cache
STORAGE_CACHE_MAX_BYTES=1073741824
FASTF1_CLEANUP_AFTER_PREPARE=true
FASTF1_USE_REQUESTS_CACHE=false
PERSIST_HISTORICAL_EVENTS_IN_DATABASE=false

S3_BUCKET=
S3_PREFIX=pitwall
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
